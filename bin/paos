#!/bin/bash
# PAOS Service Manager
# Usage: paos gateway {start|stop|restart|status|url}

PAOS_DIR="$HOME/Documents/vibecoding/paos"
PAOS_URL="http://127.0.0.1:8000"
PYTHON="$PAOS_DIR/.venv/bin/python3"
LOG_DIR="$PAOS_DIR/logs"
PID_FILE="$PAOS_DIR/.paos.pid"

_ensure_dirs() {
    mkdir -p "$LOG_DIR"
}

_is_running() {
    if [ -f "$PID_FILE" ]; then
        local pid
        pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
        rm -f "$PID_FILE"
    fi
    return 1
}

_health_check() {
    curl -sf "$PAOS_URL/api/v1/config" >/dev/null 2>&1
}

gateway_start() {
    if _is_running && _health_check; then
        local pid
        pid=$(cat "$PID_FILE")
        echo "PAOS already running (PID: $pid)"
        echo "URL: $PAOS_URL"
        return 0
    fi

    _ensure_dirs

    cd "$PAOS_DIR" || { echo "Cannot cd to $PAOS_DIR"; exit 1; }
    nohup "$PYTHON" -m uvicorn paos.main:app --host 127.0.0.1 --port 8000 \
        >> "$LOG_DIR/paos-stdout.log" 2>> "$LOG_DIR/paos-stderr.log" &
    echo $! > "$PID_FILE"

    local attempts=0
    while [ $attempts -lt 15 ]; do
        if _health_check; then
            echo "PAOS started (PID: $(cat "$PID_FILE"))"
            echo "URL: $PAOS_URL"
            return 0
        fi
        attempts=$((attempts + 1))
        sleep 1
    done

    echo "Failed to start PAOS"
    echo "Check logs: $LOG_DIR/paos-stderr.log"
    rm -f "$PID_FILE"
    exit 1
}

gateway_stop() {
    if [ -f "$PID_FILE" ]; then
        local pid
        pid=$(cat "$PID_FILE")
        kill "$pid" 2>/dev/null
        sleep 1
        kill -9 "$pid" 2>/dev/null
        rm -f "$PID_FILE"
    fi
    echo "PAOS stopped"
}

gateway_restart() {
    gateway_stop
    sleep 1
    gateway_start
}

gateway_status() {
    if _is_running; then
        local pid
        pid=$(cat "$PID_FILE")
        echo "PAOS running (PID: $pid)"
        if _health_check; then
            echo "Health: OK"
            echo "URL: $PAOS_URL"
        else
            echo "Health: FAIL (service not responding on $PAOS_URL)"
        fi
    else
        echo "PAOS is not running"
        return 1
    fi
}

gateway_url() {
    if _is_running && _health_check; then
        echo "$PAOS_URL"
    else
        echo "PAOS is not running" >&2
        return 1
    fi
}

snapshot_save() {
    local name="${3:-}"
    if [ -z "$name" ]; then
        name="$(date +%Y%m%d_%H%M%S)"
    fi

    cd "$PAOS_DIR" || { echo "Cannot cd to $PAOS_DIR"; exit 1; }

    if [ ! -d .git ]; then
        echo "Error: Git repo not initialized in $PAOS_DIR"
        exit 1
    fi

    local has_changes
    has_changes=$(git status --porcelain 2>/dev/null)
    if [ -z "$has_changes" ]; then
        echo "No changes to save"
        return 0
    fi

    git add -A
    git commit -m "snapshot: $name" --quiet
    git tag -a "snap/$name" -m "PAOS snapshot: $name"

    local short_hash
    short_hash=$(git rev-parse --short HEAD)
    local file_count
    file_count=$(git diff --stat HEAD~1 HEAD | tail -1 | awk '{print $1}')
    echo "Snapshot saved: $name ($short_hash)"
    echo "  Files changed: $file_count"
}

snapshot_list() {
    cd "$PAOS_DIR" || { echo "Cannot cd to $PAOS_DIR"; exit 1; }

    if ! git tag -l "snap/*" | head -1 | grep -q .; then
        echo "No snapshots found"
        return 0
    fi

    echo "PAOS Snapshots:"
    echo "─────────────────────────────────────────────────"
    git tag -l "snap/*" --sort=-creatordate | while read tag; do
        local name="${tag#snap/}"
        local date
        date=$(git log -1 --format="%ai" "$tag" 2>/dev/null | cut -d' ' -f1,2)
        local msg
        msg=$(git tag -l "$tag" --format="%(contents)" 2>/dev/null | head -1)
        local short_hash
        short_hash=$(git rev-parse --short "$tag" 2>/dev/null)
        printf "  %-30s %s  %s\n" "$name" "$date" "$short_hash"
    done
    echo "─────────────────────────────────────────────────"
    echo "Total: $(git tag -l "snap/*" | wc -l | tr -d ' ') snapshots"
}

snapshot_restore() {
    local name="${3:-}"
    if [ -z "$name" ]; then
        echo "Usage: paos snapshot restore <name>"
        echo "Run 'paos snapshot list' to see available snapshots"
        exit 1
    fi

    cd "$PAOS_DIR" || { echo "Cannot cd to $PAOS_DIR"; exit 1; }

    local tag="snap/$name"
    if ! git tag -l "$tag" | grep -q .; then
        echo "Error: Snapshot '$name' not found"
        echo "Run 'paos snapshot list' to see available snapshots"
        exit 1
    fi

    local current_hash
    current_hash=$(git rev-parse HEAD)
    local target_hash
    target_hash=$(git rev-parse "$tag")

    if [ "$current_hash" = "$target_hash" ]; then
        echo "Already at snapshot '$name'"
        return 0
    fi

    local has_uncommitted
    has_uncommitted=$(git status --porcelain 2>/dev/null)
    if [ -n "$has_uncommitted" ]; then
        local auto_name="auto-before-restore-$(date +%Y%m%d_%H%M%S)"
        echo "Saving uncommitted changes as '$auto_name'..."
        git add -A
        git commit -m "auto-save before restore: $name" --quiet
        git tag -a "snap/$auto_name" -m "Auto-save before restoring $name"
        echo "  Saved: $auto_name"
    fi

    echo "Restoring to snapshot '$name'..."
    git checkout "$tag" -- . 2>/dev/null
    if [ $? -ne 0 ]; then
        echo "Error: Restore failed"
        exit 1
    fi

    git add -A
    git commit -m "restore: $name" --quiet

    echo "Restored to snapshot '$name'"
    echo "  Restart PAOS service to apply changes: paos gateway restart"
}

snapshot_diff() {
    local name="${3:-}"
    if [ -z "$name" ]; then
        echo "Usage: paos snapshot diff <name>"
        echo "Run 'paos snapshot list' to see available snapshots"
        exit 1
    fi

    cd "$PAOS_DIR" || { echo "Cannot cd to $PAOS_DIR"; exit 1; }

    local tag="snap/$name"
    if ! git tag -l "$tag" | grep -q .; then
        echo "Error: Snapshot '$name' not found"
        exit 1
    fi

    echo "Diff: snapshot '$name' vs current"
    echo "─────────────────────────────────────────────────"
    git diff --stat "$tag" HEAD 2>/dev/null
    echo "─────────────────────────────────────────────────"
    echo "Run 'git diff $tag HEAD' for full details"
}

case "$1" in
    gateway)
        case "$2" in
            start)   gateway_start   ;;
            stop)    gateway_stop    ;;
            restart) gateway_restart ;;
            status)  gateway_status  ;;
            url)     gateway_url     ;;
            *)       echo "Usage: paos gateway {start|stop|restart|status|url}" ;;
        esac
        ;;
    snapshot)
        case "$2" in
            save)    snapshot_save "$@" ;;
            list)    snapshot_list      ;;
            restore) snapshot_restore "$@" ;;
            diff)    snapshot_diff "$@" ;;
            *)
                echo "PAOS Snapshot Manager"
                echo "Usage: paos snapshot {save|list|restore|diff}"
                echo ""
                echo "  save [name]     Save current state as snapshot (auto-name if omitted)"
                echo "  list            List all snapshots"
                echo "  restore <name>  Restore to a snapshot (auto-saves uncommitted changes)"
                echo "  diff <name>     Show changes since a snapshot"
                ;;
        esac
        ;;
    *)
        echo "PAOS Service Manager"
        echo "Usage: paos {gateway|snapshot}"
        echo ""
        echo "  gateway {start|stop|restart|status|url}  Service management"
        echo "  snapshot {save|list|restore|diff}         Version management"
        ;;
esac
